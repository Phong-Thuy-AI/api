  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/utils/migrateEmailOptional.js && node dist/utils/migrateFocusArea.js && node dist/utils/migrateTrialFields.js && node dist/utils/migrateDailyHoroscope.js && node dist/server.js",
