    "migrate:email-optional": "ts-node -r tsconfig-paths/register src/utils/migrateEmailOptional.ts",
    "migrate:focus-area": "ts-node -r tsconfig-paths/register src/utils/migrateFocusArea.ts",
    "migrate:focus-area:prod": "node dist/utils/migrateFocusArea.js",
    "migrate:trial-fields": "ts-node -r tsconfig-paths/register src/utils/migrateTrialFields.ts",
    "migrate:daily-horoscope": "ts-node -r tsconfig-paths/register src/utils/migrateDailyHoroscope.ts",
    "migrate:daily-horoscope:prod": "node dist/utils/migrateDailyHoroscope.js",
    "test": "jest"
  },
  "keywords": [],
