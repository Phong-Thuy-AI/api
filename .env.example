# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT & Security Configuration
JWT_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_here

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root_password_here
DB_NAME=phongthuy_simcathung

# Web2M Payment API Configuration
WEB2M_API_GET_QR=https://api.web2m.com/api/QR
WEB2M_API_GET_TRANSACTION=https://api.web2m.com/api/getTransaction
WEB2M_BANK_NAME=MBBank
WEB2M_BANK_NUMBER=123456789
WEB2M_BANK_PASSWORD=your_password
WEB2M_BANK_TOKEN=your_web2m_token
WEB2M_ACCOUNT_HOLDER=NGUYEN VAN A
WEB2M_IS_MASK=false
WEB2M_BANK_BACKGROUND=default

# Gemini / OpenAI API Configuration
AI_PROVIDER=gemini # or openai
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=contact@phongthuysimcathung.com

# Business Configuration
ZALO_ADMIN_NUMBER=0362931719
CREDIT_VALIDITY_DAYS=50

# Docker & Deployment Configuration
COMPOSE_DB_HOST=db
COMPOSE_DB_PORT=3306
NGINX_SERVER_NAME=api.phongthuysimcathung.com
